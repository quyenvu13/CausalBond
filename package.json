{
  "name": "causalbond",
  "version": "2.0.0-studionext",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:ast": "python3 scripts/check_contract_ast.py",
    "check:logic": "python3 scripts/test_contract_logic.py",
    "check:adversarial": "python3 scripts/test_contract_logic.py --suite adversarial",
    "check:fence": "python3 scripts/fence_probe.py contracts/CausalBond.py",
    "check:mutations": "python3 scripts/mutation_matrix.py",
    "gate:contract": "python3 scripts/gate_v03_runtime.py contracts/CausalBond.py",
    "gate:schema": "python3 scripts/probe_v03_schema.py contracts/CausalBond.py",
    "check": "npm run check:ast && npm run check:logic && npm run check:adversarial && npm run check:fence && npm run check:mutations && npm run build",
    "gate:ui": "node scripts/gate_pending_lock.mjs",
    "verify:deployed": "bash scripts/verify_deployed_source.sh"
  },
  "dependencies": {
    "@genlayer/transaction-kit": "0.1.0-rc.2",
    "@genlayer/transaction-kit-react": "0.1.0-rc.2",
    "genlayer-js": "2.0.0-rc.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
}
